{
  "$schema": "./design-system.schema.json",
  "_comment": "Source of truth for all design tokens. Run `npm run tokens` to apply changes to globals.css.",

  "meta": {
    "name": "wchat",
    "version": "1.0.0",
    "colorFormat": "oklch"
  },

  "theme": {
    "light": {
      "_comment": "oklch(lightness chroma hue) — lightness: 0–1, chroma: 0–0.4, hue: 0–360",

      "background":            "oklch(0.98 0.005 280)",
      "foreground":            "oklch(0.18 0.02 280)",

      "card":                  "oklch(1 0 0)",
      "card-foreground":       "oklch(0.18 0.02 280)",

      "popover":               "oklch(1 0 0)",
      "popover-foreground":    "oklch(0.18 0.02 280)",

      "primary":               "oklch(0.5 0.22 290)",
      "primary-foreground":    "oklch(0.985 0 0)",

      "secondary":             "oklch(0.94 0.015 280)",
      "secondary-foreground":  "oklch(0.3 0.05 280)",

      "muted":                 "oklch(0.94 0.015 280)",
      "muted-foreground":      "oklch(0.55 0.04 280)",

      "accent":                "oklch(0.92 0.025 290)",
      "accent-foreground":     "oklch(0.35 0.1 290)",

      "destructive":           "oklch(0.577 0.245 27.325)",

      "border":                "oklch(0.88 0.02 280)",
      "input":                 "oklch(0.9 0.02 280)",
      "ring":                  "oklch(0.6 0.15 290)",

      "chart-1":               "oklch(0.6 0.2 290)",
      "chart-2":               "oklch(0.55 0.18 260)",
      "chart-3":               "oklch(0.65 0.15 310)",
      "chart-4":               "oklch(0.7 0.12 240)",
      "chart-5":               "oklch(0.5 0.22 320)",

      "radius":                "0.75rem",

      "sidebar":               "oklch(0.97 0.008 280)",
      "sidebar-foreground":    "oklch(0.18 0.02 280)",
      "sidebar-primary":       "oklch(0.5 0.22 290)",
      "sidebar-primary-foreground": "oklch(0.985 0 0)",
      "sidebar-accent":        "oklch(0.92 0.025 290)",
      "sidebar-accent-foreground": "oklch(0.35 0.1 290)",
      "sidebar-border":        "oklch(0.88 0.02 280)",
      "sidebar-ring":          "oklch(0.6 0.15 290)"
    },

    "dark": {
      "background":            "oklch(0.13 0.03 285)",
      "foreground":            "oklch(0.93 0.015 280)",

      "card":                  "oklch(0.18 0.035 285)",
      "card-foreground":       "oklch(0.93 0.015 280)",

      "popover":               "oklch(0.18 0.035 285)",
      "popover-foreground":    "oklch(0.93 0.015 280)",

      "primary":               "oklch(0.62 0.22 290)",
      "primary-foreground":    "oklch(0.98 0 0)",

      "secondary":             "oklch(0.22 0.04 285)",
      "secondary-foreground":  "oklch(0.93 0.015 280)",

      "muted":                 "oklch(0.22 0.04 285)",
      "muted-foreground":      "oklch(0.65 0.04 285)",

      "accent":                "oklch(0.25 0.06 290)",
      "accent-foreground":     "oklch(0.93 0.015 280)",

      "destructive":           "oklch(0.704 0.191 22.216)",

      "border":                "oklch(1 0 0 / 8%)",
      "input":                 "oklch(1 0 0 / 12%)",
      "ring":                  "oklch(0.62 0.22 290)",

      "chart-1":               "oklch(0.62 0.22 290)",
      "chart-2":               "oklch(0.58 0.2 260)",
      "chart-3":               "oklch(0.67 0.18 310)",
      "chart-4":               "oklch(0.72 0.14 240)",
      "chart-5":               "oklch(0.55 0.22 320)",

      "sidebar":               "oklch(0.17 0.035 285)",
      "sidebar-foreground":    "oklch(0.93 0.015 280)",
      "sidebar-primary":       "oklch(0.62 0.22 290)",
      "sidebar-primary-foreground": "oklch(0.98 0 0)",
      "sidebar-accent":        "oklch(0.25 0.06 290)",
      "sidebar-accent-foreground": "oklch(0.93 0.015 280)",
      "sidebar-border":        "oklch(1 0 0 / 8%)",
      "sidebar-ring":          "oklch(0.62 0.22 290)"
    }
  },

  "glass": {
    "_comment": "Source of truth for all glassmorphism utilities (classes are generated into globals.css).",
    "blur": {
      "panel":   "24px",
      "surface": "12px",
      "chip":    "8px"
    },
    "saturate": {
      "panel":   "180%",
      "surface": "160%",
      "chip":    "140%"
    },
    "panel": {
      "light": {
        "background": "linear-gradient(135deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.72) 100%)",
        "border": "rgba(255, 255, 255, 0.6)",
        "shadow": "0 8px 32px rgba(139, 92, 246, 0.08), 0 2px 8px rgba(0, 0, 0, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.9)"
      },
      "dark": {
        "background": "linear-gradient(135deg, rgba(30, 16, 60, 0.82) 0%, rgba(20, 10, 45, 0.72) 100%)",
        "border": "rgba(139, 92, 246, 0.18)",
        "shadow": "0 8px 32px rgba(0, 0, 0, 0.35), 0 2px 8px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(139, 92, 246, 0.12)"
      }
    },
    "surface": {
      "light": {
        "background": "rgba(255, 255, 255, 0.68)",
        "border": "rgba(255, 255, 255, 0.55)",
        "shadow": "0 4px 16px rgba(139, 92, 246, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.8)"
      },
      "dark": {
        "background": "rgba(35, 20, 65, 0.65)",
        "border": "rgba(139, 92, 246, 0.14)",
        "shadow": "0 4px 16px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(139, 92, 246, 0.08)"
      }
    },
    "chip": {
      "light": {
        "background": "rgba(255, 255, 255, 0.78)",
        "border": "rgba(255, 255, 255, 0.65)",
        "shadow": "0 2px 8px rgba(139, 92, 246, 0.05)"
      },
      "dark": {
        "background": "rgba(40, 24, 70, 0.72)",
        "border": "rgba(139, 92, 246, 0.16)",
        "shadow": "0 2px 8px rgba(0, 0, 0, 0.2)"
      }
    },
    "frame": {
      "light": {
        "background": "rgba(255, 255, 255, 0.12)",
        "border": "rgba(255, 255, 255, 0.55)",
        "shadow": "0 18px 60px rgba(17, 12, 46, 0.08), 0 2px 10px rgba(0, 0, 0, 0.04)"
      },
      "dark": {
        "background": "rgba(10, 6, 24, 0.22)",
        "border": "rgba(139, 92, 246, 0.16)",
        "shadow": "0 18px 60px rgba(0, 0, 0, 0.45), 0 2px 10px rgba(0, 0, 0, 0.2)"
      }
    }
  },

  "scrollbar": {
    "width":        "4px",
    "thumb":        "rgba(139, 92, 246, 0.25)",
    "thumb-hover":  "rgba(139, 92, 246, 0.5)"
  },

  "background-gradient": {
    "light": "from-violet-50 via-purple-50 to-indigo-100",
    "dark":  "from-[#0d0820] via-[#110c2e] to-[#0f1035]"
  },

  "typography": {
    "font-sans":  "Inter",
    "font-mono":  "Geist Mono",
    "weights":    ["300", "400", "500", "600", "700"],
    "sizes": {
      "xs":   "0.75rem",
      "sm":   "0.875rem",
      "base": "1rem",
      "lg":   "1.125rem",
      "xl":   "1.25rem",
      "2xl":  "1.5rem"
    }
  }
}
