# LLM providers
GROQ_API_KEY=GROQ_API_KEY
GEMINI_API_KEY=GEMINI_API_KEY
# MySQL MCP (database tools for the chat). Leave MCP_URL empty to disable.
# Local dev: run database_mcp with MCP_TRANSPORT=http and use http://localhost:8000/mcp
# Docker Compose overrides MCP_URL automatically.
MCP_URL=
MYSQL_USER=
MYSQL_PASSWORD=
# Database on your machine, seen from Docker: host.docker.internal
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_ALLOW_WRITE=false

# Where /config saves the connection; local dev only (Docker Compose sets it).
MYSQL_CONFIG_FILE=
